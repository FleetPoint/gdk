const FleetPoint = require("./api");

FleetPoint:checkServer();
FleetPoint:verifyParams();

const function map<T, U>(t: {T}, f: (value: T, index: number) -> U): {U}
    local result: {U} = {}
    for i, v in ipairs(t) do
        result[i] = f(v, i)
    end
    return result
end

const function filter<T>(t: {T}, f: (value: T, index: number) -> boolean): {T}
    local result: {T} = {}
    for i, v in ipairs(t) do
        if f(v, i) then
            table.insert(result, v)
        end
    end
    return result
end

game:BindToClose(FleetPoint.endLiveSessions)

const spawnedBusesDirectory = workspace:WaitForChild("SpawnedBuses");
const speedScalar: number = (script.Parent:GetAttribute("InchesPerStud")/12) * (60/88)

const requireControlUnit: boolean = script.Parent:GetAttribute("RequireControlUnit");

while true do
    local spawnedBuses = spawnedBusesDirectory:GetChildren();

    spawnedBuses = filter(spawnedBuses, function(bus)
        return bus:IsA("Model") and bus:FindFirstChild("Body") and (not requireControlUnit or bus:FindFirstChild("Body"):FindFirstChild("FleetPointControlUnit"));
    end);

    const busLocations = map(spawnedBuses, function(bus)
        const driveSeat: VehicleSeat = bus.DriveSeat
        const speed = driveSeat.AssemblyLinearVelocity.Magnitude * speedScalar

        const _, heading = driveSeat.CFrame:ToOrientation()

        return {
            busId = bus:GetAttribute("BusId");
            location = {driveSeat.CFrame.Position.X, driveSeat.CFrame.Position.Y, math.deg(heading), speed};
        };
    end);

    task.spawn(FleetPoint.updateLocations, FleetPoint, busLocations);

    task.wait(15);
end