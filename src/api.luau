const HttpService = game:GetService("HttpService");
const RunService = game:GetService("RunService");

const GDKVersion: number = script.Parent.PackageLink.VersionNumber;
const mapId = script.Parent:GetAttribute("MapId");

const Types = require("./types");

const baseUrl = "https://api.fleetpointapp.com/connect";

const serverId = RunService:IsStudio() and `studio-{HttpService:GenerateGUID(false)}` or game.JobId;

const API = {}

function API:sendRequest<T>(endpoint: string, method: "GET" | "POST", body: any?): T
    const success, result = pcall(function()
        return HttpService:RequestAsync({
            Url = `{baseUrl}{endpoint}`;
            Method = method;
            Headers = {
                Authorization = HttpService:GetSecret("FleetPoint_API_Key"):AddPrefix("Bearer ");
                ["X-GDK-Version"] = `{GDKVersion}`;
                ["Content-Type"] = "application/json";
            };
            Body = body and HttpService:JSONEncode(body) or nil;
        });
    end)

    if (success) then
        if (result.Success) then
            return HttpService:JSONDecode(result.Body) :: T;
        else
            error(`FleetPoint API request failed! Status Code: {result.StatusCode}, Body: {result.Body}`);
        end
    else
        error(`FleetPoint API request failed! Error: {result}`);
    end
end

function API:checkServer()
    const success, result = pcall(function()
        return HttpService:GetAsync(`{baseUrl}/status`);
    end)

    if (success) then
        const parsed = HttpService:JSONDecode(result) :: Types.ConnectResponse;

        if (parsed.status ~= "OK") then
            error(`Unable to connect to FleetPoint API!`);
        end

        if parsed.gdkMinimumVersion > GDKVersion then
            error(`Your GDK version is out of date! Please update to the latest version.`);
        end

        if parsed.gdkLatestVersion > GDKVersion then
            warn(`A new GDK version is available! Please update to the latest version.`);
        end

        warn(`Connected to FleetPoint API! Server Version: {parsed.serverVersion}`);
    else
        error(`Unable to connect to FleetPoint API!`);
    end
end

function API:verifyParams()
    if (not mapId or mapId == 0) then
        error(`FleetPoint map ID is not set! Please set it in the FleetPointGDK configuration.`);
    end

    const response: Types.VerifyResponse = API:sendRequest("/verify", "POST", { mapId = mapId });

    if (not response.success) then
        error(`FleetPoint map ID is invalid! Please check your configuration.`);
    end

    warn(`Using FleetPoint map '{response.mapName}' under '{response.companyName}'`);
end

function API:getSpawnerConfiguration(): Types.SpawnerConfiguration
    return API:sendRequest(`/maps/{mapId}/spawner-configuration`, "GET");
end

function API:getBusStatus(busId: string): Types.BusStatusResponse
    return API:sendRequest(`/maps/{mapId}/buses/{busId}/status`, "GET");
end

function API:logSpawn(player: Player, busId: string)
    return API:sendRequest(`/maps/{mapId}/buses/{busId}/log`, "POST", { 
        serverId = serverId,
        busId = busId,
        triggeredByRobloxId = player.UserId,
        logData = {
            type = "SPAWNED",
            spawnedByRobloxId = player.UserId,
        }
    });
end

function API:logDespawn(player: Player, busId: string)
    return API:sendRequest(`/maps/{mapId}/buses/{busId}/log`, "POST", { 
        serverId = serverId,
        busId = busId,
        triggeredByRobloxId = player.UserId,
        logData = {
            type = "DESPAWNED",
            despawnedByRobloxId = player.UserId,
        }
    });
end

function API:updateLocations(locations: {{ busId: string; location: {number} }})
    return API:sendRequest(`/maps/{mapId}/buses/locations`, "POST", { 
        serverId = serverId,
        locations = locations,
    });
end

function API:endLiveSessions()
    return API:sendRequest(`/maps/{mapId}/end-live-sessions`, "POST", { serverId = serverId });
end

return API